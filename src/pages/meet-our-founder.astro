---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';

// Captions are required for spoken video. Add a .vtt file under public/media and set its path here.
const videos = [
  { src: '/media/founder-video-1.mp4', title: 'Video 1 from the founder', captions: '' },
  { src: '/media/founder-video-2.mp4', title: 'Video 2 from the founder', captions: '' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Veronica Magembe',
    jobTitle: 'Founder & Executive Director',
    worksFor: { '@type': 'NGO', name: site.name },
    image: new URL('/images/founder-veronica-magembe-800.webp', Astro.site).href,
  },
];
---

<BaseLayout
  title="Meet our founder"
  description="Meet Veronica Magembe, founder and executive director of America Back to God Mission."
  jsonLd={jsonLd}
>
  <PageHero title="Meet our founder" eyebrow="About us" />

  <section class="section" data-reveal aria-labelledby="founder-name">
    <div class="container split split--wide-left founder">
      <div class="founder__intro">
        <SectionHeading number="01" eyebrow="Founder & Executive Director" id="founder-name" title="Veronica Magembe" />
        <ul class="founder__social" aria-label="Follow us">
          <li>
            <a class="btn btn--outline" href={site.social.facebook} target="_blank" rel="noopener noreferrer">
              <Icon name="facebook" /> Facebook<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a class="btn btn--outline" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
              <Icon name="instagram" /> Instagram<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a class="btn btn--outline" href={site.social.youtube} target="_blank" rel="noopener noreferrer">
              <Icon name="youtube" /> YouTube<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="founder__photo">
        <Picture id="founder-veronica-magembe" sizes="(min-width: 64rem) 26rem, 90vw" ratio="1 / 1" loading="eager" />
      </div>
    </div>
    <div class="container container--narrow prose founder__bio">
      <p>
        Veronica Magembe grew up in Uganda during the years of Idi Amin’s rule, an experience that gave her a lasting
        appreciation for freedom. After moving to the United States, she returned to school and became a nurse.
      </p>
      <p>
        When the events of September 11, 2001 shook the nation, the Holy Spirit placed a burden on Veronica’s heart to
        intercede for America. Guided by 2 Chronicles 7:14, she mobilized members of Victory Family Church in Boston,
        under the leadership of Pastor Samuel Kasozi, together with believers from other churches and communities, to
        pray for God’s mercy and restoration over the nation. That call to prayer grew into America Back to God, and
        today she leads the America Back to God Prayer Group, which meets virtually every Monday to intercede for the
        United States.
      </p>
      <aside class="founder__gatherings" aria-label="Prayer meeting schedule">
        <h2>Join us in prayer</h2>
        <p>
          The weekly Monday prayer group meets virtually. Separately, the mission hosts an in-person prayer meeting on
          the first Friday of each month in Alpharetta. <a href="/contact-us/">Contact us for details about joining the
          Monday group</a>, or see <a href="/events/monthly-prayer-meeting/">details for the in-person monthly meeting</a>.
        </p>
      </aside>
      <p>
        An intercessor, worshipper, and evangelist, Veronica’s heart also reaches back to her homeland. In the villages
        of Uganda, she has led a gospel crusade where many gave their lives to Jesus Christ, and organized outreaches
        providing families with everyday necessities such as sugar, salt, and soap. Partnering with Christian mothers,
        she helped rescue two boys from life on the streets; both are now in foster care and attending school. She also
        pays the school fees for three orphaned children who lost their mother in childbirth and are being raised by
        their grandmother.
      </p>
      <p>Her service is shaped by James 1:27:</p>
      <blockquote>
        <p>“Pure religion and undefiled before God and the Father is this, To visit the fatherless and widows in their
        affliction, and to keep himself unspotted from the world.”</p>
        <cite>James 1:27</cite>
      </blockquote>
      <p>
        Veronica has been married for over thirty years to Dr. Ronald Magembe. They are blessed with three daughters,
        Bridget, Ronah, and Angelina, and three grandchildren. After many years in Boston, she now lives in Atlanta,
        Georgia, where she continues to pray daily for her family, her community, and the nation.
      </p>
    </div>
  </section>

  <section class="section section--paper-deep" data-reveal aria-labelledby="videos-title">
    <div class="container">
      <SectionHeading number="02" eyebrow="Watch" id="videos-title" title="Videos" />
      <div class="videos">
        {videos.map((v) => (
          <figure>
            <video controls preload="metadata" playsinline aria-label={v.title}>
              <source src={v.src} type="video/mp4" />
              {v.captions && <track kind="captions" src={v.captions} srclang="en" label="English" default />}
              <p>Your browser cannot play this video. <a href={v.src}>Download it</a>.</p>
            </video>
            <figcaption>{v.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .founder__photo {
    max-width: 26rem;
  }
  .founder__photo :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  .founder__intro :global(.section-heading) {
    margin-bottom: var(--space-6);
  }
  .founder__intro :global(.section-heading h2) {
    font-size: var(--step-4);
  }
  .founder__bio {
    margin-top: var(--space-8);
  }
  .founder__gatherings {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 4px solid var(--red-600);
    border-radius: var(--radius);
  }
  .founder__gatherings h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--step-1);
  }
  .founder__gatherings p {
    margin: 0;
  }
  .founder__bio blockquote {
    margin: var(--space-5) 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--navy-300);
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .founder__bio blockquote p {
    margin: 0 0 var(--space-2);
  }
  .founder__bio cite {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-style: normal;
    color: var(--text-muted);
  }
  .founder__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .videos {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 48rem) {
    .videos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  figure {
    margin: 0;
  }
  video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--navy-950);
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
