---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FormEmbed from '../components/FormEmbed.astro';
---

<BaseLayout
  title="Volunteering"
  description="Contribute your time and skills to support the initiatives of America Back to God Mission."
  cta={false}
>
  <PageHero title="Volunteering" eyebrow="Get involved">
    <p>Contribute your time and skills to support our initiatives.</p>
  </PageHero>

  <section class="section" data-reveal aria-labelledby="volunteer-title">
    <div class="container container--narrow">
      <SectionHeading number="01" eyebrow="Volunteer" id="volunteer-title" title="Lend a hand" />
      <FormEmbed form="volunteer" fallbackIntro="Our online volunteer form is being connected. Until then, please call or email us to volunteer." />
    </div>
  </section>
</BaseLayout>
