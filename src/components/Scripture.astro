---
// 2 Chronicles 7:14 (NKJV). This verse is printed on the mission's own banners and flyers.
// The copyright line is required by the publisher when quoting the NKJV.
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<figure class:list={['scripture', dark && 'on-dark']}>
  <blockquote>
    <p>
      &ldquo;If My people who are called by My name will humble themselves, and pray and seek My face, and turn from
      their wicked ways, then I will hear from heaven, and will forgive their sin and heal their land.&rdquo;
    </p>
  </blockquote>
  <figcaption>
    <span class="scripture__ref">2 Chronicles 7:14 (NKJV)</span>
    <span class="scripture__credit">
      Scripture taken from the New King James Version&reg;. Copyright &copy; 1982 by Thomas Nelson. Used by
      permission. All rights reserved.
    </span>
  </figcaption>
</figure>

<style>
  .scripture {
    margin: 0;
  }
  blockquote {
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--heading);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .scripture__ref {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--red-600);
  }
  .on-dark .scripture__ref {
    color: var(--red-300);
  }
  .scripture__credit {
    max-width: 40rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .scripture.on-dark {
    background: transparent;
  }
</style>
