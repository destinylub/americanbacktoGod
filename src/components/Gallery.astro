---
// Photo grid. With filters it also runs the lightbox and the All / 2023 Conference / 2022 filter buttons.
// Without JavaScript every photo is a plain link to the large image and the filter buttons are hidden.
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import gallery from '../data/gallery.json';
import { getImage, imageUrl } from '../lib/images';

interface Props {
  /** Show only the first N photos and skip filters and lightbox chrome (used on the home page). */
  limit?: number;
  filters?: boolean;
  /** Specific image ids to feature, in order (used on the home page). */
  pick?: string[];
}

const { limit, filters = true, pick } = Astro.props;

const all = gallery.photos.map((p) => {
  const img = getImage(p.image);
  return {
    ...p,
    img,
    portrait: img.height > img.width,
    full: imageUrl(p.image, img.widths.at(-1)!, 'webp'),
  };
});

const groupLabel = Object.fromEntries(gallery.groups.map((g) => [g.id, g.label]));
let photos = pick ? pick.map((id) => all.find((p) => p.image === id)!).filter(Boolean) : all;
if (limit) photos = photos.slice(0, limit);
---

<div class="gallery" data-gallery>
  {
    filters && (
      <div class="gallery__filters" role="group" aria-label="Filter photos" data-filters>
        <button type="button" class="gallery__filter" aria-pressed="true" data-filter="all">All</button>
        {gallery.groups.map((g) => (
          <button type="button" class="gallery__filter" aria-pressed="false" data-filter={g.id}>{g.label}</button>
        ))}
      </div>
    )
  }
  <p class="sr-only" role="status" aria-live="polite" data-status></p>

  <ul class:list={['gallery__grid', !filters && 'gallery__grid--preview']} role="list">
    {
      photos.map((p, i) => (
        <li class="gallery__item" data-group={p.group}>
          <a
            href={filters ? p.full : '/gallery/'}
            class="gallery__link"
            aria-haspopup={filters ? 'dialog' : undefined}
            data-lightbox-item
            data-full={p.full}
            data-width={p.img.width}
            data-height={p.img.height}
            data-alt={p.img.alt}
            data-group-label={groupLabel[p.group]}
          >
            <Picture
              id={p.image}
              sizes="(min-width: 75rem) 24rem, (min-width: 48rem) 33vw, 46vw"
              loading={filters && i < 4 ? 'eager' : 'lazy'}
              ratio={p.portrait ? '3 / 4' : '4 / 3'}
            />
            <span class="sr-only">{filters ? 'View larger' : 'View in the gallery'}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    filters && (
      <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
        <div class="lightbox__frame">
          <button type="button" class="lightbox__btn lightbox__close" data-lb-close>
            <Icon name="x" />
            <span class="sr-only">Close</span>
          </button>
          <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev>
            <Icon name="chevron-left" />
            <span class="sr-only">Previous photo</span>
          </button>
          <button type="button" class="lightbox__btn lightbox__next" data-lb-next>
            <Icon name="chevron-right" />
            <span class="sr-only">Next photo</span>
          </button>
          <img class="lightbox__img" alt="" width="1200" height="800" data-lb-img />
          <p class="lightbox__caption" data-lb-caption></p>
        </div>
      </dialog>
    )
  }
</div>

<style>
  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  html:not(.js) .gallery__filters {
    display: none;
  }
  .gallery__filter {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--navy-600);
    background: transparent;
    border: 2px solid var(--navy-600);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .gallery__filter:hover {
    background: var(--navy-50);
  }
  .gallery__filter[aria-pressed='true'] {
    background: var(--navy-600);
    color: var(--white);
  }

  /* Two crops only (4:3 and 3:4) in a column layout keep the grid even without cropping faces badly. */
  .gallery__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 2 10rem;
    column-gap: var(--space-4);
  }
  @media (min-width: 48rem) {
    .gallery__grid {
      columns: 3 14rem;
    }
  }
  /* Home preview: even rows, one crop */
  .gallery__grid--preview {
    display: grid;
    columns: auto;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 48rem) {
    .gallery__grid--preview {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery__grid--preview .gallery__item {
    margin-bottom: 0;
  }
  .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
  .gallery__item[hidden] {
    display: none;
  }
  .gallery__link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--navy-100);
  }
  .gallery__link :global(img) {
    width: 100%;
    transition: transform 0.4s var(--ease);
  }
  .gallery__link:hover :global(img) {
    transform: scale(1.03);
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    color: var(--white);
    background: rgb(23 23 46 / 0.96);
    border: 0;
  }
  .lightbox::backdrop {
    background: rgb(23 23 46 / 0.96);
  }
  .lightbox:not([open]) {
    display: none;
  }
  .lightbox__frame {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    height: 100%;
    padding: var(--space-8) var(--space-4) var(--space-4);
  }
  .lightbox__img {
    align-self: center;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    min-height: 0;
    object-fit: contain;
  }
  .lightbox__caption {
    max-width: 44rem;
    margin: var(--space-4) 0 0;
    text-align: center;
    font-size: var(--step--1);
    color: var(--navy-100);
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    color: var(--white);
    background: rgb(255 255 255 / 0.1);
    border: 2px solid rgb(255 255 255 / 0.5);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.25);
  }
  .lightbox__btn:focus-visible {
    outline: 3px solid var(--red-300);
    outline-offset: 3px;
  }
  .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: var(--space-4);
  }
  .lightbox__next {
    right: var(--space-4);
  }
  @media (max-width: 40rem) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: var(--space-4);
      transform: none;
    }
  }
</style>

<script>
  // Filters and lightbox. Runs once per gallery on the page.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.gallery__item'));
    const links = items.map((li) => li.querySelector<HTMLAnchorElement>('[data-lightbox-item]')!);
    const status = root.querySelector<HTMLElement>('[data-status]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');

    // Filters
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
      btn.addEventListener('click', () => {
        const group = btn.dataset.filter!;
        for (const b of root.querySelectorAll('[data-filter]')) b.setAttribute('aria-pressed', String(b === btn));
        let shown = 0;
        for (const li of items) {
          const match = group === 'all' || li.dataset.group === group;
          li.hidden = !match;
          if (match) shown++;
        }
        if (status) status.textContent = `Showing ${shown} photos: ${btn.textContent}`;
      });
    }

    if (!dialog) continue;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    let visible: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + visible.length) % visible.length;
      const link = visible[index];
      img.src = link.dataset.full!;
      img.width = Number(link.dataset.width);
      img.height = Number(link.dataset.height);
      img.alt = link.dataset.alt ?? '';
      caption.textContent = `${link.dataset.alt}  (${index + 1} of ${visible.length}, ${link.dataset.groupLabel})`;
    };

    for (const link of links) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        visible = links.filter((l) => !l.closest<HTMLElement>('.gallery__item')!.hidden);
        show(visible.indexOf(link));
        dialog.showModal();
        dialog.querySelector<HTMLElement>('[data-lb-close]')?.focus();
      });
    }

    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    // Clicking the dark area around the photo closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as Element).classList.contains('lightbox__frame')) dialog.close();
    });
  }
</script>
