---
// Shows the date of the next monthly prayer meeting. The date is computed at build time, and a small
// script corrects it in the browser if the site has not been rebuilt since the last meeting.
import { getUpcoming } from '../lib/events';
import site from '../data/site.json';

const next = getUpcoming().find((o) => o.isRecurring);
---

{
  next && (
    <time
      datetime={next.startDate}
      data-next-meeting
      data-end-time={next.event.endTime}
      data-timezone={site.timezone}
    >
      {next.dateLabel}
    </time>
  )
}

<script>
  import { firstFriday, formatLongDate, todayInZone, zonedToUtc } from '../lib/dates';

  // Every date on the page is the same meeting, so work it out once. When the date built into the page is
  // still in the future (the normal case) there is nothing to change and the script does almost no work.
  const els = Array.from(document.querySelectorAll<HTMLTimeElement>('time[data-next-meeting]'));
  if (els.length) {
    const { timezone: tz, endTime } = els[0].dataset as { timezone: string; endTime: string };
    const now = new Date();
    const today = todayInZone(now, tz);
    if (els[0].dateTime <= today) {
      const [y, m] = today.split('-').map(Number);
      for (let i = 0; i < 4; i++) {
        const date = firstFriday(y + Math.floor((m - 1 + i) / 12), ((m - 1 + i) % 12) + 1);
        if (zonedToUtc(date, endTime, tz) >= now) {
          for (const el of els) {
            el.dateTime = date;
            el.textContent = formatLongDate(date);
          }
          break;
        }
      }
    }
  }
</script>
