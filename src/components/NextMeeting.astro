---
// Shows the date of the next monthly prayer meeting. The date is computed at build time, and a small
// script corrects it in the browser if the site has not been rebuilt since the last meeting.
import { getUpcoming } from '../lib/events';
import site from '../data/site.json';

const next = getUpcoming().find((o) => o.isRecurring);
---

{
  next && (
    <time
      datetime={next.startDate}
      data-next-meeting
      data-end-time={next.event.endTime}
      data-timezone={site.timezone}
    >
      {next.dateLabel}
    </time>
  )
}

<script>
  import { firstFriday, formatLongDate, todayInZone, zonedToUtc } from '../lib/dates';

  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-next-meeting]')) {
    const tz = el.dataset.timezone!;
    const endTime = el.dataset.endTime!;
    const now = new Date();
    const [y, m] = todayInZone(now, tz).split('-').map(Number);
    for (let i = 0; i < 4; i++) {
      const date = firstFriday(y + Math.floor((m - 1 + i) / 12), ((m - 1 + i) % 12) + 1);
      if (zonedToUtc(date, endTime, tz) >= now) {
        if (el.dateTime !== date) {
          el.dateTime = date;
          el.textContent = formatLongDate(date);
        }
        break;
      }
    }
  }
</script>
